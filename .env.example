# Vercel Project Settings > Environment Variables (Production and Preview).
# Copy these two public values from the SAME Supabase project used by the backend.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
# Enable only after voice is enabled and verified on the backend.
VOICE_ENABLED=false
# The Render API origin is already configured in vercel.json.
